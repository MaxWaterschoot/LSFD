<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="build\RagePluginHook.props" />

  <PropertyGroup>
    <AssemblyName>LSFD</AssemblyName>
    <RootNamespace>LSFD</RootNamespace>
    <Version>0.3.0</Version>
    <!-- Ships LSFD.xml so callout authors get IntelliSense for the LSFD.API namespace. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Examples\**" />
    <None Remove="Examples\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installed in the GTA V folder by the user, so don't copy it to the output. -->
    <PackageReference Include="RAGENativeUI" Version="1.9.3" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- For NativeFunction.Natives, the only way RPH calls natives with out parameters. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Plugins/LSFD/ folder ships with the download; LSFD won't start without it. -->
    <None Update="Plugins\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Plugins\**\.gitkeep" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
